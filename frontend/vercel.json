{
  "framework": "vite",
  "functions": {
    "api/satellites.ts": {
      "maxDuration": 60
    },
    "api/satellites-profiles/index.py": {
      "regions": ["iad1"],
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/satellites",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/satellites-profiles",
      "schedule": "0 10 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "live-satellite-tracker.vercel.app"
        }
      ],
      "destination": "https://live-satellite-tracker.com/$1",
      "permanent": true
    }
  ]
}